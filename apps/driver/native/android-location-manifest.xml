<!-- Merge into the signed Android driver application's manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <application>
    <!-- The native shell must implement this service and its persistent active-trip notification. -->
    <service android:name=".location.ActiveTripLocationService" android:exported="false" android:foregroundServiceType="location" />
  </application>
</manifest>
