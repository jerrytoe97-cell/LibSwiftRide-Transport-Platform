NODE_ENV=development
DATABASE_URL=postgresql://libswiftride:libswiftride@localhost:5432/libswiftride
REDIS_URL=redis://localhost:6379
ROUTING_PROVIDER=osrm
ROUTING_API_URL=https://router.project-osrm.org
GOOGLE_MAPS_SERVER_API_KEY=
# Production-equivalent staging must replace the public demo URL with an approved HTTPS routing service.
ROUTING_TIMEOUT_MS=8000
ROUTE_POINT_RETENTION_DAYS=30
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
MFA_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PAYMENTS_ENABLED=false
DEMO_MODE=false
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
NOTIFICATION_PROVIDER=sandbox
EMAIL_PROVIDER=hooks
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_APP_PASSWORD=
ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_TOKEN=
ORANGE_MONEY_NUMBER=
MTN_MOMO_API_URL=
MTN_MOMO_API_TOKEN=
MTN_MOMO_NUMBER=
STRIPE_PAYMENT_HOOK_URL=
STRIPE_API_TOKEN=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
SMS_DELIVERY_URL=
SMS_DELIVERY_TOKEN=
PUSH_DELIVERY_URL=
PUSH_DELIVERY_TOKEN=
METRICS_TOKEN=
# Keep disabled until a private S3-compatible bucket is configured. Never commit credentials.
KYC_STORAGE_PROVIDER=disabled
KYC_S3_ENDPOINT=
KYC_S3_REGION=auto
KYC_S3_BUCKET=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
KYC_S3_FORCE_PATH_STYLE=false
KYC_S3_SERVER_SIDE_ENCRYPTION=provider
KYC_S3_KMS_KEY_ID=
# sandbox is fictional-only. webhook is required before KYC_FICTIONAL_ONLY may be false.
KYC_SCANNER_PROVIDER=disabled
KYC_SCANNER_URL=
KYC_SCANNER_TOKEN=
KYC_SCANNER_TIMEOUT_MS=10000
KYC_FICTIONAL_ONLY=true
KYC_UPLOAD_MAX_BYTES=5242880
VITE_API_URL=http://localhost:4000/api/v1
# Production uses google. Keep preview only for local development without a browser-restricted key.
VITE_MAP_PROVIDER=preview
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_WS_URL=ws://localhost:4000/ws
VITE_WEB_PUSH_PUBLIC_KEY=
VITE_WEB_URL=http://localhost:3000
VITE_PASSENGER_APP_URL=http://localhost:3001
VITE_DRIVER_APP_URL=http://localhost:3002
VITE_FLEET_APP_URL=http://localhost:3003
VITE_ADMIN_APP_URL=http://localhost:3004
VITE_DISPATCHER_APP_URL=http://localhost:3005
VITE_BUSINESS_APP_URL=http://localhost:3006
