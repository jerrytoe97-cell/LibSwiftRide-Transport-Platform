    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^6.0.12",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.3",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.12.0",
