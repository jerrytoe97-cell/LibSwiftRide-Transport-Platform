NODE_ENV=development
DATABASE_URL=postgresql://libswiftride:libswiftride@localhost:5432/libswiftride
REDIS_URL=redis://localhost:6379
ROUTING_PROVIDER=osrm
ROUTING_API_URL=https://router.project-osrm.org
MAPBOX_ROUTING_TOKEN=
# Server-only Mapbox Geocoding v6 credential. Never use a VITE_ variable for it.
GEOCODING_API_TOKEN=
# Enable only after approving Mapbox permanent-geocoding billing/storage rights.
GEOCODING_ENABLED=false
SURGE_PRICING_ENABLED=false
# Production-equivalent staging must replace the public demo URL with an approved HTTPS routing service.
ROUTING_TIMEOUT_MS=8000
ROUTE_POINT_RETENTION_DAYS=30
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
MFA_ENCRYPTION_KEY=replace-with-a-dedicated-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PAYMENTS_ENABLED=false
DEMO_MODE=false
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
NOTIFICATION_PROVIDER=sandbox
EMAIL_PROVIDER=hooks
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Zoho SMTP: use port 465 with secure=true, or port 587 with secure=false. Never commit the app password.
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_APP_PASSWORD=
ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_TOKEN=
ORANGE_MONEY_NUMBER=
MTN_MOMO_API_URL=
MTN_MOMO_API_TOKEN=
MTN_MOMO_NUMBER=
STRIPE_PAYMENT_HOOK_URL=
STRIPE_API_TOKEN=
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
SMS_DELIVERY_URL=
SMS_DELIVERY_TOKEN=
PUSH_DELIVERY_URL=
PUSH_DELIVERY_TOKEN=
METRICS_TOKEN=
# Keep disabled until a private S3-compatible bucket is configured. Never commit credentials.
KYC_STORAGE_PROVIDER=disabled
KYC_S3_ENDPOINT=
# Native AWS S3: leave KYC_S3_ENDPOINT empty and set an AWS region such as eu-west-1 in the deployment environment.
KYC_S3_REGION=replace-with-approved-aws-region
KYC_S3_BUCKET=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
KYC_S3_FORCE_PATH_STYLE=false
KYC_S3_SERVER_SIDE_ENCRYPTION=AES256
KYC_S3_KMS_KEY_ID=
# sandbox is fictional-only. webhook is required before KYC_FICTIONAL_ONLY may be false.
KYC_SCANNER_PROVIDER=disabled
KYC_SCANNER_URL=
KYC_SCANNER_TOKEN=
KYC_SCANNER_TIMEOUT_MS=10000
KYC_FICTIONAL_ONLY=true
KYC_UPLOAD_MAX_BYTES=5242880
# Scanner-service-only configuration. KYC_SCANNER_TOKEN must match the API secret without being committed.
KYC_SCANNER_ALLOWED_DOWNLOAD_HOSTS=
KYC_SCANNER_MAX_BYTES=5242880
KYC_SCANNER_DOWNLOAD_TIMEOUT_MS=8000
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=8000
VITE_API_URL=http://localhost:4000/api/v1
# Keep preview mode until a Mapbox account, budget alerts and environment-specific public token are approved.
VITE_MAP_PROVIDER=preview
VITE_MAPBOX_ACCESS_TOKEN=
VITE_WS_URL=ws://localhost:4000/ws
VITE_WEB_PUSH_PUBLIC_KEY=
VITE_WEB_URL=http://localhost:3000
VITE_PASSENGER_APP_URL=http://localhost:3001
VITE_DRIVER_APP_URL=http://localhost:3002
VITE_FLEET_APP_URL=http://localhost:3003
VITE_ADMIN_APP_URL=http://localhost:3004
VITE_DISPATCHER_APP_URL=http://localhost:3005
VITE_BUSINESS_APP_URL=http://localhost:3006
VITE_COMPANY_PHONE=0779614995
